[Unit]
Description=FirstBoot
After=local-fs.target
Before=ssh.service rc-local.service
ConditionFileNotEmpty=/boot/firmware/firstboot.sh

[Service]
ExecStart=/boot/firmware/firstboot.sh
ExecStartPost=/bin/mv /boot/firmware/firstboot.sh /boot/firmware/firstboot.sh.done
Type=oneshot
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
